#!/usr/bin/python3
"""マンデルブロ・ドリフトの起動用。
ページをこのパソコンの中だけで配信して、ブラウザで開く。
（Ubuntu標準のFirefoxはsnap版で、/usr/share のファイルを直接開けないため）
"""
import http.server
import shutil
import subprocess
import threading
import time
import webbrowser

DIR = '/usr/share/mandelbrot-drift'


class Handler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=DIR, **kwargs)

    def log_message(self, *args):
        pass


server = http.server.ThreadingHTTPServer(('127.0.0.1', 0), Handler)
url = f'http://127.0.0.1:{server.server_address[1]}/index.html'
threading.Thread(target=server.serve_forever, daemon=True).start()

# Chrome系のブラウザがあれば、アドレスバーのないアプリ風の窓で開く
for name in ('google-chrome', 'google-chrome-stable', 'chromium', 'chromium-browser',
             'microsoft-edge', 'brave-browser'):
    path = shutil.which(name)
    if path:
        subprocess.Popen([path, f'--app={url}', '--start-maximized'],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        break
else:
    webbrowser.open(url)  # なければいつものブラウザ（Firefoxなど）で開く

# ページは1回読み込めば後は通信しないので、2分待って配信を終える
time.sleep(120)
server.shutdown()
